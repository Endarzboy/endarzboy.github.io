---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} — News</title>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    <description>{{ site.description | strip | xml_escape }}</description>
    <language>{{ site.lang | default: 'en' }}</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    {%- assign items = site.news | sort: "date" | reverse %}
    {%- for n in items limit: 30 %}
    <item>
      <title>{{ n.title | xml_escape }}</title>
      <link>{{ '/news/' | absolute_url }}</link>
      <guid isPermaLink="false">{{ n.id | default: n.title | slugify }}-{{ n.date | date: '%Y%m%d' }}</guid>
      <pubDate>{{ n.date | date_to_rfc822 }}</pubDate>
      <description>{{ n.content | markdownify | xml_escape }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
